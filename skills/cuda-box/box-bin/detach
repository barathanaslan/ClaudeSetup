#!/bin/bash
# detach — run a long job detached from the current (ssh) session on the cuda box.
# Windows ends every child of an ssh session when the connection drops. A process created
# through WMI (Win32_Process.Create) is not a child of the session, so it survives.
#
#   detach '<bash command>' [name]   start it; cwd = current dir; log = ~/jobs/<name>.log
#   detach list                      every job and whether its pid is still alive
#   detach tail <name> [n]           last n lines of a job's log (default 40)
#   detach kill <name>               stop a job and its whole process tree
set -u
JOBS="$HOME/jobs"; mkdir -p "$JOBS"

# tasklist /FI would have its /flags rewritten into paths by Git Bash; MSYS_NO_PATHCONV stops that.
alive() { MSYS_NO_PATHCONV=1 tasklist /FI "PID eq $1" /NH 2>/dev/null | grep -qE "^[^ ]+ +$1 "; }

case "${1:-help}" in
  list)
    shopt -s nullglob; any=0
    for f in "$JOBS"/*.pid; do
      any=1; n=$(basename "$f" .pid); pid=$(cat "$f")
      if alive "$pid"; then st=RUNNING; else st=done; fi
      last=$(tail -n 1 "$JOBS/$n.log" 2>/dev/null | cut -c1-70)
      printf "%-8s %-30s pid %-7s %s\n" "$st" "$n" "$pid" "$last"
    done
    [ "$any" = 1 ] || echo "no detached jobs"
    ;;
  tail)
    [ -n "${2:-}" ] || { echo "usage: detach tail <name> [n]"; exit 2; }
    tail -n "${3:-40}" "$JOBS/$2.log"
    ;;
  kill)
    [ -n "${2:-}" ] || { echo "usage: detach kill <name>"; exit 2; }
    pid=$(cat "$JOBS/$2.pid") && MSYS_NO_PATHCONV=1 taskkill /PID "$pid" /T /F
    ;;
  help|"")
    sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'
    ;;
  *)
    cmd="$1"; name="${2:-job-$(date +%Y%m%d-%H%M%S)}"
    case "$name" in *[!A-Za-z0-9._-]*) echo "name must be [A-Za-z0-9._-]"; exit 2;; esac
    log="$JOBS/$name.log"; : > "$log"
    wlog=$(cygpath -m "$log")
    bash_exe=$(cygpath -w "$(command -v bash)")
    # The job runs as: bash -lc "echo <b64> | base64 -d | bash > log 2>&1", where the decoded
    # text is `cd <cwd> && (<cmd>)`. base64 keeps every quote in <cmd> intact.
    b64=$(printf 'cd %q && (%s)\n' "$PWD" "$cmd" | base64 | tr -d '\n')
    cl="\"$bash_exe\" -lc \"echo $b64 | base64 -d | bash > $wlog 2>&1\""
    pid=$(powershell -NoProfile -Command "(Invoke-CimMethod -ClassName Win32_Process -MethodName Create -Arguments @{CommandLine='$cl'; CurrentDirectory='$(cygpath -w "$PWD")'}).ProcessId" | tr -d '\r')
    [ -n "$pid" ] || { echo "failed to start"; exit 1; }
    echo "$pid" > "$JOBS/$name.pid"
    echo "started $name (pid $pid)  log: ~/jobs/$name.log"
    ;;
esac
